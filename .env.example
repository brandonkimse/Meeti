# Where2 configuration. Copy to .env.local and adjust.
# Everything is optional: with no values set, Where2 runs on free OpenStreetMap services.

# --- Demo mode -------------------------------------------------------------
# Adds "Try the live demo" (a private sample world with simulated friends).
# `npm run dev:demo` sets this for you.
WHERE2_DEMO_MODE=false

# --- Google Maps Platform (optional, recommended for production) -----------
# Enables real public-transit travel times (Distance Matrix API) and place
# photos + ratings (Places API (New)). Without it, transit times are a labelled
# estimate and place data comes from OpenStreetMap.
GOOGLE_MAPS_API_KEY=

# --- Map tiles (optional) --------------------------------------------------
# Defaults to openstreetmap.org tiles, which are fine for development but not
# for production traffic. Use a provider such as MapTiler or Stadia Maps:
# NEXT_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=

# --- Routing / geocoding endpoints (optional) ------------------------------
# Public OSRM servers are rate-limited. For real traffic, self-host OSRM
# (one instance per profile) and point these at it.
WHERE2_OSRM_CAR_URL=
WHERE2_OSRM_FOOT_URL=
WHERE2_OSRM_BIKE_URL=
# Backup car router; set to an empty string to disable.
# WHERE2_OSRM_CAR_FALLBACK_URL=https://router.project-osrm.org
# Self-hosted routers can take more traffic:
# WHERE2_ROUTING_CONCURRENCY=8
# WHERE2_ROUTING_GAP_MS=0
WHERE2_PHOTON_URL=
WHERE2_NOMINATIM_URL=
# Identify your deployment to OSM services (their usage policy asks for this).
WHERE2_USER_AGENT=

# --- Storage ---------------------------------------------------------------
# Directory for the SQLite database (default: ./data).
WHERE2_DATA_DIR=
